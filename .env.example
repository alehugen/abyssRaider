# Supabase — apenas valores PÚBLICOS (Project Settings > API)
# Na Vercel, a integração Supabase já cria NEXT_PUBLIC_SUPABASE_URL e
# SUPABASE_PUBLISHABLE_KEY, que o vite.config.ts usa como fallback.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Somente no servidor (Vercel > Settings > Environment Variables)
CRON_SECRET=troque-isto

# Notificações push: chave PÚBLICA VAPID (vai no front). Gere o par com:
#   npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Notificações push, somente no servidor (Vercel), nunca no front:
#   VAPID_PRIVATE_KEY = chave privada do mesmo par
#   PUSH_SECRET       = resultado de: select secret from public.push_config;
VAPID_PRIVATE_KEY=troque-isto
PUSH_SECRET=troque-isto
