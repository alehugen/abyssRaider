# Supabase — apenas valores PÚBLICOS (Project Settings > API)
# Na Vercel, a integração Supabase já cria NEXT_PUBLIC_SUPABASE_URL e
# SUPABASE_PUBLISHABLE_KEY, que o vite.config.ts usa como fallback.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Somente no servidor (Vercel > Settings > Environment Variables)
CRON_SECRET=troque-isto
